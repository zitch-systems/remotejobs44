/* RemoteJobs44 — shared UI helpers, icons, reusable bits. */
const ICONS = {
  home:'<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/>',
  search:'<circle cx="11" cy="11" r="7.5"/><path d="M21 21l-4.3-4.3"/>',
  brief:'<rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M8 7V5.5A2.5 2.5 0 0 1 10.5 3h3A2.5 2.5 0 0 1 16 5.5V7"/><path d="M3 12h18"/>',
  bookmark:'<path d="M6 4h12a1 1 0 0 1 1 1v16l-7-4-7 4V5a1 1 0 0 1 1-1z"/>',
  user:'<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
  bell:'<path d="M6 9a6 6 0 1 1 12 0c0 6 2 7 2 7H4s2-1 2-7z"/><path d="M10.5 20a1.8 1.8 0 0 0 3 0"/>',
  moon:'<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/>',
  back:'<path d="M15 18l-6-6 6-6"/>',
  chevron:'<path d="M9 18l6-6-6-6"/>',
  sliders:'<path d="M4 6h11M4 12h7M4 18h14"/><circle cx="18" cy="6" r="2"/><circle cx="14" cy="12" r="2"/><circle cx="20" cy="18" r="2"/>',
  check:'<path d="M20 6L9 17l-5-5"/>',
  bolt:'<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  pin:'<path d="M12 22s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/>',
  x:'<path d="M6 6l12 12M18 6L6 18"/>',
  share:'<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/>',
  arrow:'<path d="M5 12h14M13 6l6 6-6 6"/>',
  doc:'<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/>',
  logout:'<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/>',
  star:'<path d="M12 3l2.6 5.6 6.1.8-4.5 4.2 1.2 6L12 17l-5.4 2.8 1.2-6L3.3 9.4l6.1-.8z"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  building:'<rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2"/>',
  filter:'<path d="M3 5h18l-7 8v5l-4 2v-7z"/>',
  crown:'<path d="M4 18h16"/><path d="M4 18l-1.4-9 5.4 4 4-7 4 7 5.4-4L20 18z"/>',
  mail:'<rect x="4" y="6" width="16" height="12" rx="1"/><path d="M4 7l8 6 8-6"/>',
  globe:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/>',
  shield:'<path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z"/>',
  help:'<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 4 2c0 1.6-2 2-2 3.2"/><path d="M12 17v0"/>',
  lock:'<rect x="6" y="11" width="12" height="9" rx="1.5"/><path d="M9 11V8a3 3 0 0 1 6 0v3"/>'
};
function svg(name, w){ return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"'+(w?(' style="width:'+w+'px;height:'+w+'px"'):'')+'>'+(ICONS[name]||'')+'</svg>'; }
function svgFill(name){ return '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none">'+(ICONS[name]||'')+'</svg>'; }

function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

function logoHTML(co, cat){
  const { logoFor, GRADS } = window.RJ;
  const m = logoFor(co); const grad = GRADS[cat] || GRADS.Engineering;
  const img = m.primary ? '<img alt="" loading="lazy" src="'+m.primary+'" onerror="if(!this.dataset.f){this.dataset.f=1;this.src=\''+m.fallback+'\'}else{this.remove()}">' : '';
  return '<div class="jlogo" style="background:'+grad+'">'+esc(m.monogram)+img+'</div>';
}

function jobCardHTML(j){
  const { Store } = window.RJ;
  const saved = Store.isSaved(j.id) ? ' on' : '';
  return '<a class="jcard" data-job="'+j.id+'">'
    + logoHTML(j.co, j.cat)
    + '<div class="jbody">'
      + '<div class="jrole">'+esc(j.role)+'</div>'
      + '<div class="jmeta">'+esc(j.co)+' · '+esc(j.region)+'</div>'
      + '<div class="jtags"><span class="tag pay">'+esc(j.pay)+'</span><span class="tag">'+esc(j.type)+'</span><span class="tag">'+esc(j.posted)+' ago</span></div>'
    + '</div>'
    + '<div class="jmatch"><div class="pct">'+j.match+'%</div><div class="lbl">match</div>'
      + '<div class="jsave'+saved+'" data-save="'+j.id+'">'+svgFill('bookmark')+'</div>'
    + '</div>'
  + '</a>';
}

function toast(msg){
  let t = document.querySelector('.toast');
  if(!t){ t = document.createElement('div'); t.className='toast'; document.body.appendChild(t); }
  t.textContent = msg; t.classList.add('show');
  clearTimeout(t._h); t._h = setTimeout(()=>t.classList.remove('show'), 1900);
}

window.RJ = Object.assign(window.RJ || {}, { ICONS, svg, svgFill, esc, logoHTML, jobCardHTML, toast });
