<script src="shared.js"></script>
<script>
  // Play the hero entrance only when the page is actually live; if the doc is
  // hidden (background/preview pane), a from-opacity:0 animation would freeze at
  // frame 0 and hide the hero. Base CSS already shows the final state.
  (function heroIn(){
    var hero = document.querySelector('.hero-b');
    if (!hero) return;
    var play = function(){ requestAnimationFrame(function(){ hero.setAttribute('data-hero-in', ''); }); };
    if (document.hidden) {
      document.addEventListener('visibilitychange', function on(){
        if (!document.hidden) { document.removeEventListener('visibilitychange', on); play(); }
      });
    } else { play(); }
  })();

  window.RJ_JOB_URL = 'B Job.html';
  initTheme('.theme-toggle', 'rj44-theme-b');
  mountMarquee('#marquee');
  mountFeatured('#featured', [1,2,6]);
  mountLiveWall('#liveWall');
  countUp('.hb-stat .n');

  // Build the auto-scrolling hero preview (compact rows, duplicated for loop).
  (function buildPreview(){
    const track = document.getElementById('previewTrack');
    if (!track) return;
    const tints = LOGO_TINTS;
    const compact = JOBS.slice(0, 8).map(j => {
      const [bg, fg] = tints[COMPANIES.indexOf(j.company) % tints.length] || ['#eff6ff','#2563eb'];
      return `<div class="prow">
        <span class="job-logo" style="--lm-bg:${bg};--lm-fg:${fg}">${monogram(j.company)}</span>
        <span><div class="pt">${j.title}</div><div class="pm">${j.company} · ${j.region}</div></span>
        <span class="pp">Verified</span>
      </div>`;
    }).join('');
    track.innerHTML = compact + compact;
  })();

</script>
</body>
</html>
