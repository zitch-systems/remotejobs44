export function Icon({ name, size = 22, color = '#0f172a', fill = 'none' }: { name: string; size?: number; color?: string; fill?: string }) {
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24" fill={fill} stroke={fill === 'none' ? color : 'none'} strokeWidth={2} strokeLinecap="round" strokeLinejoin="round">
      {(P[name] || '').split(' M').map((seg, i) => <Path key={i} d={(i ? 'M' : '') + seg} />)}
    </Svg>
  );
}

export function Logo({ size = 34 }: { size?: number }) {
  return (
    <Svg width={size} height={size} viewBox="0 0 32 32">
      <Rect width={32} height={32} rx={8} fill="#1e3a5f" />
      <Path d="M8 20 Q12 10 16 16 Q20 22 23 12" stroke="#fff" strokeWidth={2.5} strokeLinecap="round" fill="none" />
      <Circle cx={23} cy={12} r={2.5} fill="#f97316" />
    </Svg>
  );
}

export function CompanyLogo({ job, size = 46 }: { job: Job; size?: number }) {
  const g = grads[job.cat] || grads.Engineering;
  const domain = ({ Paystack:'paystack.com', Flutterwave:'flutterwave.com', Vercel:'vercel.com', Andela:'andela.com', Shopify:'shopify.com', Notion:'notion.so', Canva:'canva.com', Intercom:'intercom.com', Buffer:'buffer.com' } as any)[job.co];
  return (
    <View style={{ width: size, height: size, borderRadius: size * 0.28, backgroundColor: g[0], alignItems: 'center', justifyContent: 'center', overflow: 'hidden' }}>
      <Text style={{ color: '#fff', fontWeight: '800', fontSize: size * 0.4 }}>{job.co[0]}</Text>
      {domain ? <Image source={{ uri: `https://icons.duckduckgo.com/ip3/${domain}.ico` }} style={{ position: 'absolute', width: size, height: size, padding: size * 0.22, backgroundColor: '#fff' }} /> : null}
    </View>
  );
}

export function JobCard({ job, onPress }: { job: Job; onPress: () => void }) {
  const { theme, isSaved, toggleSave } = useStore();
  const s = mk(theme);
  return (
    <Pressable style={s.card} onPress={onPress}>
      <CompanyLogo job={job} />
      <View style={{ flex: 1, minWidth: 0 }}>
        <Text style={s.role} numberOfLines={1}>{job.role}</Text>
        <Text style={s.meta}>{job.co} · {job.region}</Text>
        <View style={s.tags}>
          <Text style={[s.tag, s.pay]}>{job.pay}</Text>
          <Text style={s.tag}>{job.type}</Text>
        </View>
      </View>
      <View style={{ alignItems: 'flex-end' }}>
        <Text style={s.match}>{job.match}%</Text>
        <Text style={s.matchL}>match</Text>
        <Pressable hitSlop={10} onPress={() => toggleSave(job.id)} style={{ marginTop: 8 }}>
          <Icon name="bookmark" size={20} color={isSaved(job.id) ? theme.accent : theme.fg4} fill={isSaved(job.id) ? theme.accent : 'none'} />
        </Pressable>
      </View>
    </Pressable>
  );
}

const mk = (t: Theme) => StyleSheet.create({
  card: { flexDirection: 'row', gap: 13, alignItems: 'flex-start', backgroundColor: t.card, borderWidth: 1.5, borderColor: t.line, borderRadius: 18, padding: 15, marginBottom: 11 },
  role: { fontWeight: '700', fontSize: 15.5, color: t.fg1 },
  meta: { fontSize: 13, color: t.fg3, marginTop: 2 },
  tags: { flexDirection: 'row', gap: 6, marginTop: 9 },
  tag: { fontSize: 11, fontWeight: '600', color: t.fg2, backgroundColor: t.bg, borderWidth: 1, borderColor: t.line, paddingHorizontal: 9, paddingVertical: 3, borderRadius: 7, overflow: 'hidden' },
  pay: { color: t.brand700, backgroundColor: t.brand50, borderColor: t.brand100 },
  match: { fontWeight: '800', fontSize: 15, color: t.success },
  matchL: { fontSize: 9.5, color: t.fg4, fontWeight: '600', textTransform: 'uppercase' },
});
