# Environment variables
.env.local
.env

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# TypeScript build cache
tsconfig.tsbuildinfo

# Git bundles
*.bundle

# Patch files left in working tree (rescue scripts, manual patches, etc.) —
# share them via PRs / commits, not as committed artifacts.
*.patch

# Playwright artifacts
playwright-report/
test-results/

# Lighthouse reports
lighthouse-report.json

# Vitest coverage output (generated in CI; can also be run locally via
# `npm run test:unit:coverage`)
coverage/

# OS files
.DS_Store
Thumbs.db

# Supabase CLI scratch (cli-latest etc.)
supabase/.temp/
supabase/.branches/

# Claude Code runtime scratch (session lock files, local agent state)
.claude/scheduled_tasks.lock
.claude/settings.local.json
