{
  "crons": [
    {
      "//": "Single scheduled cron — /daily does ingest + expiry + alerts in one pass. The /ingest and /expire-daily routes remain callable manually with CRON_SECRET for debug re-runs, but scheduling them in parallel raced /daily on the shared profiles/subscriptions upserts and triple-fired the Resend alert burst.",
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "app/api/cron/daily/route.ts":        { "maxDuration": 60 },
    "app/api/cron/ingest/route.ts":       { "maxDuration": 60 },
    "app/api/cron/expire-daily/route.ts": { "maxDuration": 30 },
    "app/api/paystack/webhook/route.ts":  { "maxDuration": 30 },
    "app/api/paystack/verify/route.ts":   { "maxDuration": 30 },
    "app/api/ai/cv-review/route.ts":      { "maxDuration": 60 },
    "app/api/ai/interview-prep/route.ts": { "maxDuration": 60 },
    "app/api/admin/ingest-now/route.ts":  { "maxDuration": 120 },
    "app/api/cv/route.ts":                { "maxDuration": 30 },
    "app/api/scrape/route.ts":            { "maxDuration": 30 },
    "app/api/ats/route.ts":               { "maxDuration": 60, "memory": 1024 }
  }
}
