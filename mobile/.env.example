# RemoteJobs44 mobile — public env (Expo inlines EXPO_PUBLIC_* at build time).
# Copy to `.env` (gitignored) and fill in. These are the SAME values the web
# app uses — the mobile app talks to the same Supabase backend.
#
# Without these the app still runs in "demo mode" (the Auth screen takes you
# straight into the prototype with seed data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables Sentry crash/error reporting (lib/sentry.ts). Leave unset
# to disable.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
