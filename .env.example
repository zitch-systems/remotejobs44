# ─────────────────────────────────────────────────────────────
# RemoteJobs44 — Environment Variables
# Copy to .env.local and fill in your values
# Never commit .env.local to Git
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RemoteJobs44

# Supabase (get from: supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://gnyilmahiyddplsrrhoq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Paystack (get from: dashboard.paystack.com → Settings → API Keys)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# Paystack Plan Codes (get after creating plans in Paystack Dashboard)
# Dashboard → Subscriptions → Plans → Create Plan → copy the plan code
PAYSTACK_PRO_MONTHLY_PLAN_CODE=PLN_xxx
PAYSTACK_PRO_ANNUAL_PLAN_CODE=PLN_xxx
PAYSTACK_TEAM_MONTHLY_PLAN_CODE=PLN_xxx
PAYSTACK_TEAM_ANNUAL_PLAN_CODE=PLN_xxx

# Cron job secret (generate a random string: openssl rand -hex 32)
CRON_SECRET=

# Optional: salt for hashing visitor IPs in the agent referral click log.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset, so this is optional.
REFERRAL_IP_SALT=

# Optional: Resend for transactional emails (resend.com)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@remotejobs44.com

# Admin two-factor auth (email one-time code). When 'true', admins must enter a
# 6-digit code emailed to the admin mailbox before the admin area or any
# /api/admin route. Requires RESEND_API_KEY (above) to send the email. Leave
# false until you've confirmed the admin mailbox receives the code at
# /security/2fa, then set to true and redeploy. (Public — it's not secret
# whether 2FA is on.)
NEXT_PUBLIC_ADMIN_MFA_REQUIRED=false
# Mailbox the login code is sent to. Defaults to admin@remotejobs44.com.
ADMIN_2FA_EMAIL=admin@remotejobs44.com
# Optional HMAC secret for signing the 2FA session cookie. Falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset (fine for a single deployment).
ADMIN_2FA_SECRET=
