# ─────────────────────────────────────────────────────────────
# RemoteJobs44 — Environment Variables
# Copy to .env.local and fill in your values
# Never commit .env.local to Git
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (get from: supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://gnyilmahiyddplsrrhoq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Paystack (get from: dashboard.paystack.com → Settings → API Keys)
# No plan codes needed: every tier is a one-time charge by amount — the
# canonical amounts live in lib/paystack/plans.ts (PLAN_AMOUNTS_KOBO).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# Cron job secret (generate a random string: openssl rand -hex 32)
CRON_SECRET=

# Optional: comma-separated emails that always resolve as admins, in addition
# to profiles.role='admin' (see lib/admin-emails.ts and docs/AUTH_AND_ADMIN.md).
HARDCODED_ADMIN_EMAILS=

# ─── Admin portal private entrance ───────────────────────────────────────────
# The admin area is NOT reachable at the public /admin URL. /admin answers 404
# to anyone who hasn't opened the private "knock" link below, which mints an
# access cookie and forwards them into the portal (see lib/admin/portal.ts +
# middleware.ts). This is obscurity in front of the real gate — every
# /api/admin route still enforces requireAdmin() (session + role + 2FA).
#
# Set this to your own private, hard-to-guess single path segment (letters,
# digits and dashes). Your admins open  https://<your-domain>/<slug>  to enter.
# Rotate any time by changing this value and redeploying. If left unset a public
# placeholder default ('portal-7f3a9k2m4x') is used — OVERRIDE IT in production,
# or the entrance is neither private nor unguessable. Generate a good value with:
#   openssl rand -hex 8
ADMIN_PORTAL_SLUG=

# Contact-form recipient + payment admin-notify address. Defaults to the
# Resend from-address mailbox if unset.
CONTACT_EMAIL=

# REQUIRED for AI provider configs: encrypts stored AI API keys at rest
# (lib/crypto/secret.ts). Generate with: openssl rand -hex 32
AI_KEYS_ENCRYPTION_KEY=

# Optional: webhook that receives error reports from lib/log.ts
# (e.g. a Discord/Slack incoming webhook). FORMAT: 'discord' or 'slack'.
ERROR_REPORT_URL=
ERROR_REPORT_FORMAT=

# Optional: extra job-ingestion source API keys (lib/ingest-pipeline.ts).
# Leave unset to skip those sources.
FINDWORK_API_KEY=
SERPAPI_KEY=

# ─── JobSpy (LinkedIn / Indeed / ZipRecruiter / Google Jobs) ─────────────────
# JobSpy is a Python scraper, so this app talks to a JobSpy API service over
# HTTP (the FastAPI wrapper around python-jobspy — deploy it yourself, e.g. a
# small container exposing GET /api/v1/search_jobs). Set JOBSPY_API_URL to
# activate: the daily cron ingests JobSpy automatically and Admin → JobSpy
# lets you search and import on demand. Leave unset to disable entirely.
# See docs/jobspy.md for setup.
JOBSPY_API_URL=
# Optional: sent as the `x-api-key` header if your JobSpy service requires auth.
JOBSPY_API_KEY=
# Optional: comma list of boards to scrape (default: indeed,linkedin,zip_recruiter,google).
JOBSPY_SITES=
# Optional: country hint Indeed requires (default: usa). Other boards ignore it.
JOBSPY_COUNTRY=usa

# Optional: salt for hashing visitor IPs in the agent referral click log.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset, so this is optional.
REFERRAL_IP_SALT=

# Optional: Resend for transactional emails (resend.com)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@remotejobs44.com

# Admin two-factor auth (email one-time code). When 'true', admins must enter a
# 6-digit code emailed to the admin mailbox before the admin area or any
# /api/admin route. Requires RESEND_API_KEY (above) to send the email. Leave
# false until you've confirmed the admin mailbox receives the code at
# /security/2fa, then set to true and redeploy. (Public — it's not secret
# whether 2FA is on.)
NEXT_PUBLIC_ADMIN_MFA_REQUIRED=false
# Mailbox the login code is sent to. Defaults to admin@remotejobs44.com.
ADMIN_2FA_EMAIL=admin@remotejobs44.com
# Client-side display companion to ADMIN_2FA_EMAIL (shown as a hint on the
# /security/2fa screen — public, so don't use a private mailbox here).
NEXT_PUBLIC_ADMIN_2FA_EMAIL=
# REQUIRED when NEXT_PUBLIC_ADMIN_MFA_REQUIRED=true. Dedicated HMAC secret for
# signing the 2FA session cookie. Must be >= 16 chars (32+ recommended). No
# fallback: if this is unset/too short, admin 2FA fails CLOSED — verify 500s and
# no admin can complete login. Generate with: openssl rand -hex 32
ADMIN_2FA_SECRET=
