function logoFor(co) {
  const c = COMPANIES[co] || {};
  const ddg = c.domain ? 'https://icons.duckduckgo.com/ip3/' + c.domain + '.ico' : '';
  const si  = c.icon ? 'https://cdn.simpleicons.org/' + c.icon : '';
  return { primary: si || ddg, fallback: ddg, monogram: co.slice(0,1) };
}

