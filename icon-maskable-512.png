  { key:'Design',      label:'Design',            count:'840'  }
];

function delay(ms){ return new Promise(r => setTimeout(r, ms)); }

/* The single seam a real backend drops into. Today: in-memory + delay. */
const API = {
  async listJobs({ q = '', cat = null, type = null, region = null } = {}) {
    await delay(140);
    const needle = q.trim().toLowerCase();
    return JOBS.filter(j =>
      (!cat || j.cat === cat) &&
      (!type || j.type === type) &&
      (!region || j.region === region) &&
      (!needle || (j.role + ' ' + j.co + ' ' + j.cat).toLowerCase().includes(needle))
    );
  },
  async getJob(id){ await delay(90); return JOBS.find(j => j.id === id) || null; },
  async categories(){ await delay(60); return CATEGORIES; },
  async signIn({ email }){ await delay(420); return { id:'me', name: nameFromEmail(email), email }; }
};

function nameFromEmail(email){
  const h = (email || '').split('@')[0].replace(/[._-]+/g,' ').trim();
  return h ? h.replace(/\b\w/g, c => c.toUpperCase()) : 'Ada Obi';
}

window.RJ = Object.assign(window.RJ || {}, { JOBS, CATEGORIES, COMPANIES, GRADS, API, logoFor, nameFromEmail });
