const CATEGORIES = [
  { key:'VA',          label:'Virtual Assistant', count:'2.1k' },
  { key:'Support',     label:'Customer Service',  count:'1.8k' },
  { key:'Marketing',   label:'Marketing',         count:'1.3k' },
