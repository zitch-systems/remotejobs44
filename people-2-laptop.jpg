  </main>
</div>

<script src="shared.js"></script>
<script>
  initTheme('.theme-toggle', 'rj44-theme-dash');
  // Unsave: remove the card with a quick fade
  document.querySelectorAll('.scard-save').forEach(function(btn){
    btn.addEventListener('click', function(){
      var card = btn.closest('.scard');
      card.style.transition = 'opacity .2s, transform .2s';
      card.style.opacity = '0'; card.style.transform = 'scale(0.96)';
      setTimeout(function(){ card.remove(); }, 200);
    });
  });
  // Filter pills (visual toggle only)
  document.querySelectorAll('.sj-filter').forEach(function(f){
    f.addEventListener('click', function(){
      document.querySelectorAll('.sj-filter').forEach(function(x){ x.classList.remove('on'); });
      f.classList.add('on');
    });
  });
</script>
</body>
</html>
