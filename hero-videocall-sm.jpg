<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RemoteJobs44 — Mobile Landing + Dashboard</title>
<style>
  *,*::before,*::after{box-sizing:border-box;}
  html,body{margin:0;height:100%;}
  body{
    min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:22px; padding:32px 24px;
    background:
      radial-gradient(120% 80% at 18% 6%, rgba(37,99,235,0.18), transparent 55%),
      radial-gradient(100% 80% at 90% 94%, rgba(249,115,22,0.12), transparent 55%),
      #070d1c;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  }
  .phones{
    display: flex; gap: clamp(20px, 4vw, 56px); align-items: flex-start; justify-content: center; flex-wrap: wrap;
  }
  .col{ display:flex; flex-direction:column; align-items:center; gap:14px; }
  .phone{
    position:relative; width:390px; height:min(844px, calc(100vh - 140px));
    border-radius:46px; padding:13px;
    background:linear-gradient(155deg,#2b3442,#0c121d 62%);
    box-shadow:0 2px 0 2px rgba(255,255,255,0.04), 40px 60px 110px rgba(0,0,0,0.55), inset 0 0 0 2px rgba(255,255,255,0.05);
  }
  .scr{
    position:relative; width:100%; height:100%; border-radius:34px; overflow:hidden; background:#fff;
  }
  .island{
    position:absolute; top:11px; left:50%; transform:translateX(-50%);
    width:108px; height:28px; background:#070b12; border-radius:16px; z-index:50; pointer-events:none;
  }
  .scr--scroll iframe{ width:calc(100% + 18px); height:100%; border:0; display:block; }
  .scr iframe{ width:100%; height:100%; border:0; display:block; }
  .cap{ color:#aeb9cd; font-size:13px; font-weight:600; text-align:center; }
  .cap b{ color:#fff; display:block; font-size:14px; margin-bottom:2px; }
  .cap span{ color:#7c8aa3; font-weight:500; }
  .tag {
    display:inline-flex; align-items:center; gap:8px; font-size:12px; font-weight:700;
    letter-spacing:0.06em; text-transform:uppercase; color:#cdd9ee;
    background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12);
    padding:7px 16px; border-radius:999px;
  }
  .tag i { width:7px; height:7px; border-radius:50%; }
  .tag.landing i { background:#3b82f6; }
  .tag.dashboard i { background:#22c55e; }
</style>
</head>
<body>
  <div class="phones">
    <!-- Landing page -->
    <div class="col">
      <span class="tag landing"><i></i>Landing page · mobile</span>
      <div class="phone">
        <div class="scr scr--scroll">
          <div class="island"></div>
          <iframe src="Deep Ocean Landing Desktop.html" title="RemoteJobs44 landing — mobile" loading="eager"></iframe>
        </div>
      </div>
      <div class="cap"><b>Deep Ocean Landing</b><span>390 px · scroll inside</span></div>
    </div>

    <!-- Member dashboard -->
    <div class="col">
      <span class="tag dashboard"><i></i>Member dashboard · mobile</span>
      <div class="phone">
        <div class="scr">
          <div class="island"></div>
          <iframe src="../app/index.html" title="RemoteJobs44 member dashboard" loading="eager"></iframe>
        </div>
      </div>
      <div class="cap"><b>Member Dashboard (PWA)</b><span>app/index.html · live app</span></div>
    </div>
  </div>
</body>
</html>
